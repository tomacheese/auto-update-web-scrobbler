{
  "name": "auto-update-web-scrobbler",
  "version": "1.0.0",
  "description": "Synchronize Web Scrobbler LevelDB file with fetch-youtube-bgm",
  "homepage": "https://github.com/tomacheese/auto-update-web-scrobbler",
  "bugs": {
    "url": "https://github.com/tomacheese/auto-update-web-scrobbler/issues"
  },
  "license": "MIT",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:tomacheese/auto-update-web-scrobbler.git"
  },
  "scripts": {
    "dev": "tsx watch ./src/main.ts",
    "start": "tsx ./src/main.ts",
    "package": "run-z clean compile packing",
    "packing": "ncc build ./dist/main.js -o output/ -m",
    "compile": "tsc -p .",
    "clean": "rimraf dist output tsconfig.tsbuildinfo",
    "fix:prettier": "prettier --write src",
    "lint:tsc": "tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:prettier": "prettier --check src",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.17.6",
    "@book000/node-utils": "1.26.41",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.15.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jest-expect-message": "1.1.3",
    "level": "10.0.0",
    "lodash": "4.18.1",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "run-z": "2.1.0",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "jest": {
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ]
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
